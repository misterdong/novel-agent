# PostgreSQL（仅用于本地开发，请在生产环境替换为强密码）
POSTGRES_DB=novel_agent
POSTGRES_USER=novel_agent
POSTGRES_PASSWORD=novel_agent_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://novel_agent:novel_agent_local@localhost:5432/novel_agent

# AI Provider
# 使用 mock 可在没有模型密钥时体验基础流程。
AI_PROVIDER=mock
AI_MODEL=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 提示词日志
AI_PROMPT_LOG_FILE=logs/ai-prompts.log
AI_PROMPT_LOG_FORMAT=text

# 模型响应日志。留空表示不记录，* 表示记录全部任务。
AI_RESPONSE_LOG_TASKS=
AI_RESPONSE_LOG_FILE=logs/ai-responses.log
AI_RESPONSE_LOG_STDOUT=false
